{
  "name": "gora-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "GORA mobile client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:native": "node scripts/build-native.mjs",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@ionic/vue": "^9.0.0",
    "@ionic/vue-router": "^9.0.0",
    "@vercel/blob": "^2.8.2",
    "ionicons": "^8.1.0",
    "leaflet": "1.9.4",
    "pinia": "^4.0.3",
    "vue": "^3.5.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/leaflet": "1.9.21",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "~4.0.18",
    "vue-tsc": "^2.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "core-js@3.50.0": true
  }
}
